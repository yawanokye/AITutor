APP_NAME=Anovlad AI Tutor
PUBLIC_APP_URL=http://localhost:8000

# Low-cost text tutoring, course-section lessons and visual plans
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_ADVANCED_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING=false
DEEPSEEK_ADVANCED_THINKING=false
ADVANCED_ROUTING_ENABLED=true
ADVANCED_ROUTING_MIN_SCORE=4
DEEPSEEK_MAX_TOKENS=7000

# Image and handwriting understanding, transcription, speech and fallback
OPENAI_API_KEY=
AI_MODEL=gpt-5.6-luna
VISION_MODEL=gpt-5.6-luna
AI_REASONING_EFFORT=low
AI_VERBOSITY=medium
MAX_OUTPUT_TOKENS=6000
VISUAL_PLAN_ENABLED=true
VISUAL_MAX_OUTPUT_TOKENS=4500
IMAGE_DETAIL=high
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
DEFAULT_VOICE=nova

# Role-based accounts and portals
AUTH_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=1440
ALLOW_PUBLIC_TEACHER_REGISTRATION=false
ALLOW_STUDENT_REGISTRATION=true
REQUIRE_LOGIN_FOR_AI=true
STUDENT_MONTHLY_AI_BUDGET_USD=1.00

# First administrator options
# ADMIN_KEY is required for the one-time administrator bootstrap screen.
ADMIN_KEY=replace-with-a-different-long-random-secret
# Optional automatic administrator provisioning at startup:
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=System Administrator

# Existing Render PostgreSQL database
DATABASE_URL=
STORAGE_DIR=data

# Reusable class lesson packages and optional shared MP4 generation
TAVUS_API_KEY=
TAVUS_VIDEO_REPLICA_ID=
STUDENT_VIDEO_MONTHLY_LIMIT=0
TEACHER_VIDEO_MONTHLY_LIMIT=20
LIVE_VIDEO_ENABLED=false
LESSON_VIDEO_ENABLED=true

# Institutional teaching controls
INSTITUTIONAL_MODE=true
COURSE_LOCK_ENABLED=true
# General knowledge is available only when a lecturer deliberately selects it for a course.
ALLOW_GENERAL_KNOWLEDGE=true
LOW_BANDWIDTH_ENABLED=true
LOW_DATA_MAX_TOKENS=1800
TEXT_ONLY_MAX_TOKENS=1200

DEMO_MODE=true
MAX_IMAGE_MB=12
MAX_AUDIO_MB=20
MAX_MATERIAL_MB=30
HISTORY_TURNS=8
RATE_LIMIT_PER_MINUTE=30
